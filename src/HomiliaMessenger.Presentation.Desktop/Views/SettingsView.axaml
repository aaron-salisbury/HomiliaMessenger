<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="HomiliaMessenger.Presentation.Desktop.Views.SettingsView"
             xmlns:vm="clr-namespace:HomiliaMessenger.Presentation.Desktop.ViewModels"
             xmlns:m="clr-namespace:HomiliaMessenger.Presentation.Desktop.Models"
             xmlns:i="using:Material.Icons.Avalonia"
             x:DataType="vm:SettingsViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.section-header">
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>
		<Style Selector="TextBlock.subsection-header">
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="0,8,0,0"/>
		</Style>
		<Style Selector="TextBlock.minor-header">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="0,6,0,0"/>
			<Setter Property="Opacity" Value="0.9"/>
		</Style>
	</UserControl.Styles>

	<UserControl.DataTemplates>
		<!-- An image model, for contact photos or selfies. -->
		<DataTemplate DataType="m:ImageModelItem">
			<Border Margin="0,6,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
				<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
					<TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" />
					<TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SizeText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
					<TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
					<StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
						<HyperlinkButton Content="License" NavigateUri="{Binding LicenseUrl}" IsVisible="{Binding HasLicenseUrl}" FontSize="12" Padding="0" />
						<TextBlock Text="{Binding SettingsText}" IsVisible="{Binding IsUserAdded}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
					</StackPanel>

					<StackPanel Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Top">
						<Button Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" Classes="accent">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<i:MaterialIcon Kind="Download" />
								<TextBlock Text="Download" />
							</StackPanel>
						</Button>
						<Button Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloading}" Content="Pause" />
						<Button Command="{Binding ChooseCommand}" IsVisible="{Binding CanChoose}" Content="Use" />
						<Button Command="{Binding DeleteCommand}" IsVisible="{Binding CanRemove}" ToolTip.Tip="{Binding RemoveHint}">
							<i:MaterialIcon Kind="TrashCanOutline" />
						</Button>
					</StackPanel>

					<StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="4" Margin="0,8,0,0">
						<ProgressBar Value="{Binding ProgressPercent}" Maximum="100" IsVisible="{Binding IsDownloading}" />
						<TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" />
					</StackPanel>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- A LoRA in the chosen folder. -->
		<DataTemplate DataType="m:ImageLoraItem">
			<Border Margin="0,6,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
				<StackPanel Spacing="4">
					<Grid ColumnDefinitions="*,Auto">
						<StackPanel Grid.Column="0">
							<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
							<TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
						</StackPanel>
						<ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding IsUsable}" OnContent="On" OffContent="Off"
									  VerticalAlignment="Top" Margin="12,0,0,0" AutomationProperties.Name="Use this LoRA" />
					</Grid>
					<TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="12" TextWrapping="Wrap" FontStyle="Italic" />

					<StackPanel Spacing="6" IsVisible="{Binding IsUsable}" Margin="0,4,0,0">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<TextBlock Grid.Column="0" Text="Strength" VerticalAlignment="Center" Margin="0,0,8,0" />
							<Slider Grid.Column="1" Value="{Binding Strength}" Minimum="{Binding MinStrength}" Maximum="{Binding MaxStrength}"
									SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Strength" />
							<TextBlock Grid.Column="2" Text="{Binding StrengthText}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" />
						</Grid>
						<Grid ColumnDefinitions="Auto,*,Auto">
							<TextBlock Grid.Column="0" Text="Trigger words" VerticalAlignment="Center" Margin="0,0,8,0" />
							<TextBox Grid.Column="1" Text="{Binding TriggerWords}" PlaceholderText="None" AutomationProperties.Name="Trigger words" />
							<Button Grid.Column="2" Content="Use found" Command="{Binding UseSuggestedTriggerWordsCommand}" IsVisible="{Binding CanUseSuggestedTriggerWords}" Margin="8,0,0,0" />
						</Grid>
						<TextBlock Text="{Binding TriggerWordsHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
						<StackPanel Orientation="Horizontal" Spacing="16">
							<CheckBox Content="Contact photos" IsChecked="{Binding ForPhotos}" />
							<CheckBox Content="Selfies" IsChecked="{Binding ForSelfies}" />
						</StackPanel>
					</StackPanel>
					<TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
				</StackPanel>
			</Border>
		</DataTemplate>
	</UserControl.DataTemplates>

	<Border>
		<ScrollViewer>
			<Grid ColumnDefinitions="*,*">
				<StackPanel Grid.Column="0" Spacing="18">

					<StackPanel Spacing="8">
						<TextBlock Text="Appearance" Classes="section-header" />

						<StackPanel>
							<TextBlock Text="Choose Theme" />
							<StackPanel Margin="20,0,0,0">
								<RadioButton IsChecked="{Binding ThemeIsSystem}" GroupName="Theme" Content="System" Command="{Binding SetThemeCommand}" CommandParameter="System" />
								<RadioButton IsChecked="{Binding ThemeIsLight}" GroupName="Theme" Content="Light" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
								<RadioButton IsChecked="{Binding ThemeIsDark}" GroupName="Theme" Content="Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
							</StackPanel>
						</StackPanel>
					</StackPanel>

					<StackPanel Spacing="8">
						<TextBlock Text="Local Models" Classes="section-header" />
						<TextBlock Text="{Binding LocalModelsHint}" TextWrapping="Wrap" Opacity="0.75" />
						<Button Command="{Binding AddModelCommand}" HorizontalAlignment="Left">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<i:MaterialIcon Kind="Plus" />
								<TextBlock Text="Add from Hugging Face" />
							</StackPanel>
						</Button>

						<ItemsControl ItemsSource="{Binding LocalModels}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="m:LocalModelItem">
									<Border Margin="0,6,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
										<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
											<TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" />
											<TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SizeText}" FontSize="12" Opacity="0.7" />
											<TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />

											<StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Top">
												<Button Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" Classes="accent">
													<StackPanel Orientation="Horizontal" Spacing="6">
														<i:MaterialIcon Kind="Download" />
														<TextBlock Text="Download" />
													</StackPanel>
												</Button>
												<Button Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloading}" Content="Pause" />
												<Button Command="{Binding DeleteCommand}" IsVisible="{Binding CanRemove}" ToolTip.Tip="Remove model">
													<i:MaterialIcon Kind="TrashCanOutline" />
												</Button>
											</StackPanel>

											<StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4" Margin="0,8,0,0">
												<ProgressBar Value="{Binding ProgressPercent}" Maximum="100" IsVisible="{Binding IsDownloading}" />
												<TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" />
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<StackPanel Spacing="8">
						<TextBlock Text="Memory Search" Classes="section-header" />
						<TextBlock Text="{Binding EmbeddingModelsHint}" TextWrapping="Wrap" Opacity="0.75" />

						<ItemsControl ItemsSource="{Binding EmbeddingModels}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="m:EmbeddingModelItem">
									<Border Margin="0,6,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
										<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
											<TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" />
											<TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SizeText}" FontSize="12" Opacity="0.7" />
											<TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />

											<StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Top">
												<Button Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" Classes="accent">
													<StackPanel Orientation="Horizontal" Spacing="6">
														<i:MaterialIcon Kind="Download" />
														<TextBlock Text="Download" />
													</StackPanel>
												</Button>
												<Button Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloading}" Content="Pause" />
												<Button Command="{Binding ChooseCommand}" IsVisible="{Binding CanChoose}" Content="Use" />
												<Button Command="{Binding DeleteCommand}" IsVisible="{Binding CanRemove}" ToolTip.Tip="Remove model">
													<i:MaterialIcon Kind="TrashCanOutline" />
												</Button>
											</StackPanel>

											<StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4" Margin="0,8,0,0">
												<ProgressBar Value="{Binding ProgressPercent}" Maximum="100" IsVisible="{Binding IsDownloading}" />
												<TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" />
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<StackPanel Spacing="8" IsVisible="{Binding IsImageGenerationAvailable}">
						<TextBlock Text="Image Generation" Classes="section-header" />
						<TextBlock Text="{Binding ImageGenerationHint}" TextWrapping="Wrap" Opacity="0.75" />
						<TextBlock Text="{Binding ImageRuntimeProblem}" IsVisible="{Binding ImageRuntimeProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
								   TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

						<!-- Processor (CPU) models -->
						<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
							<i:MaterialIcon Kind="Chip" Width="20" Height="20" VerticalAlignment="Center" />
							<TextBlock Text="On the processor (CPU only)" Classes="subsection-header" Margin="0" VerticalAlignment="Center" />
						</StackPanel>
						<TextBlock Text="{Binding CpuImageHint}" TextWrapping="Wrap" Opacity="0.75" />

						<TextBlock Text="Profile photos" Classes="minor-header" />
						<TextBlock Text="{Binding ImageModelsHint}" TextWrapping="Wrap" Opacity="0.75" />
						<Button Command="{Binding AddImageModelCommand}" HorizontalAlignment="Left">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<i:MaterialIcon Kind="Plus" />
								<TextBlock Text="Add from Hugging Face" />
							</StackPanel>
						</Button>
						<ItemsControl ItemsSource="{Binding ImageModels}" />

						<TextBlock Text="Selfies" Classes="minor-header" />
						<TextBlock Text="{Binding SelfieModelsHint}" TextWrapping="Wrap" Opacity="0.75" />
						<TextBlock Text="{Binding FaceMatchingStatus}" TextWrapping="Wrap" FontSize="12" />
						<Button Command="{Binding AddSelfieModelCommand}" HorizontalAlignment="Left">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<i:MaterialIcon Kind="Plus" />
								<TextBlock Text="Add from Hugging Face" />
							</StackPanel>
						</Button>
						<ItemsControl ItemsSource="{Binding SelfieModels}" />

						<!-- Graphics card (GPU) models -->
						<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
							<i:MaterialIcon Kind="ExpansionCard" Width="20" Height="20" VerticalAlignment="Center" />
							<TextBlock Text="On a graphics card (GPU)" Classes="subsection-header" Margin="0" VerticalAlignment="Center" />
						</StackPanel>
						<TextBlock Text="{Binding GpuImageHint}" TextWrapping="Wrap" Opacity="0.75" />
						<TextBlock Text="{Binding GpuStatus}" TextWrapping="Wrap" FontSize="12" />

						<Border Padding="12" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" IsVisible="{Binding IsCudaOffered}">
							<StackPanel Spacing="6">
								<Grid ColumnDefinitions="*,Auto">
									<StackPanel Grid.Column="0">
										<TextBlock Text="CUDA runtime for NVIDIA cards" FontWeight="SemiBold" />
										<TextBlock Text="{Binding CudaHint}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
									</StackPanel>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Top">
										<Button Command="{Binding DownloadCudaCommand}" IsVisible="{Binding CanDownloadCuda}" Classes="accent">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<i:MaterialIcon Kind="Download" />
												<TextBlock Text="Download" />
											</StackPanel>
										</Button>
										<Button Command="{Binding CancelCudaDownloadCommand}" IsVisible="{Binding IsCudaDownloading}" Content="Pause" />
										<Button Command="{Binding RemoveCudaCommand}" IsVisible="{Binding CanRemoveCuda}" ToolTip.Tip="Remove the CUDA runtime">
											<i:MaterialIcon Kind="TrashCanOutline" />
										</Button>
									</StackPanel>
								</Grid>
								<HyperlinkButton Content="NVIDIA CUDA license" NavigateUri="https://docs.nvidia.com/cuda/eula/index.html" FontSize="12" Padding="0" />
								<ProgressBar Value="{Binding CudaProgress}" Maximum="100" IsVisible="{Binding IsCudaDownloading}" />
								<TextBlock Text="{Binding CudaStatus}" FontSize="12" TextWrapping="Wrap" />
							</StackPanel>
						</Border>

						<TextBlock Text="Profile photos" Classes="minor-header" />
						<TextBlock Text="{Binding GpuImageModelsHint}" TextWrapping="Wrap" Opacity="0.75" />
						<Button Command="{Binding AddGpuImageModelCommand}" HorizontalAlignment="Left">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<i:MaterialIcon Kind="Plus" />
								<TextBlock Text="Add from Hugging Face" />
							</StackPanel>
						</Button>
						<ItemsControl ItemsSource="{Binding GpuImageModels}" />

						<TextBlock Text="Selfies" Classes="minor-header" />
						<TextBlock Text="{Binding GpuSelfieModelsHint}" TextWrapping="Wrap" Opacity="0.75" />
						<Button Command="{Binding AddGpuSelfieModelCommand}" HorizontalAlignment="Left">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<i:MaterialIcon Kind="Plus" />
								<TextBlock Text="Add from Hugging Face" />
							</StackPanel>
						</Button>
						<ItemsControl ItemsSource="{Binding GpuSelfieModels}" />

						<!-- LoRAs, for any model whose base they fit -->
						<StackPanel Spacing="8" IsVisible="{Binding IsLoraAvailable}">
							<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
								<i:MaterialIcon Kind="LayersTripleOutline" Width="20" Height="20" VerticalAlignment="Center" />
								<TextBlock Text="LoRAs" Classes="subsection-header" Margin="0" VerticalAlignment="Center" />
							</StackPanel>
							<TextBlock Text="{Binding LoraHint}" TextWrapping="Wrap" Opacity="0.75" />
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Command="{Binding ChooseLoraFolderCommand}">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<i:MaterialIcon Kind="FolderOpenOutline" />
										<TextBlock Text="Choose folder" />
									</StackPanel>
								</Button>
								<Button Command="{Binding ScanLorasCommand}" IsVisible="{Binding HasLoraFolder}" ToolTip.Tip="Read the folder again">
									<i:MaterialIcon Kind="Refresh" />
								</Button>
								<Button Command="{Binding ClearLoraFolderCommand}" IsVisible="{Binding HasLoraFolder}" ToolTip.Tip="Stop using this folder (its files are kept)">
									<i:MaterialIcon Kind="Close" />
								</Button>
							</StackPanel>
							<SelectableTextBlock Text="{Binding LoraFolder}" IsVisible="{Binding HasLoraFolder}" FontSize="12" TextWrapping="Wrap" />
							<TextBlock Text="{Binding LoraStatus}" FontSize="12" TextWrapping="Wrap" />
							<ItemsControl ItemsSource="{Binding Loras}" />
						</StackPanel>
					</StackPanel>


                    <StackPanel Spacing="8">
                        <TextBlock Text="Text to Speech" Classes="section-header" />
                        <TextBlock Text="Kokoro v1.0 · 326 MB · Apache 2.0" FontWeight="SemiBold" />
                        <TextBlock Text="Read new replies aloud on this computer. English voices are included; no account or GPU is needed. Download Kokoro, choose a voice for each contact, then turn speech on in the chat ribbon. Chats always start with speech off after relaunch."
                                   TextWrapping="Wrap" Opacity="0.75" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Download Kokoro" Command="{Binding DownloadSpeechCommand}" IsVisible="{Binding CanDownloadSpeech}" />
                            <Button Content="Cancel download" Command="{Binding CancelSpeechDownloadCommand}" IsVisible="{Binding IsSpeechDownloading}" />
                            <CheckBox Content="Use Kokoro" IsChecked="{Binding SpeechEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding !IsSpeechDownloading}" IsVisible="{Binding HasSpeechModel}" />
                            <Button Content="Remove model" Command="{Binding RemoveSpeechModelCommand}" IsVisible="{Binding HasSpeechModel}" />
                        </StackPanel>
                        <ProgressBar Value="{Binding SpeechProgress}" Maximum="100" IsVisible="{Binding IsSpeechDownloading}" />
                        <TextBlock Text="{Binding SpeechStatus}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding IsWebSearchAvailable}">
                        <TextBlock Text="Web Search" Classes="section-header" />
                        <TextBlock Text="{Binding WebSearchHint}" TextWrapping="Wrap" Opacity="0.75" />
                        <CheckBox Content="Let contacts search the web" IsChecked="{Binding WebSearchEnabled, Mode=TwoWay}" />

                        <StackPanel Spacing="8" Margin="20,0,0,0" IsEnabled="{Binding WebSearchEnabled}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Tavily" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <HyperlinkButton Content="Get an API key" NavigateUri="https://app.tavily.com" Padding="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <CheckBox Content="Use Tavily" IsChecked="{Binding TavilyEnabled, Mode=TwoWay}" />
                            <TextBlock Text="A key is saved in the system's credential store." IsVisible="{Binding HasTavilyKey}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding TavilyKeyInput}" PasswordChar="•" Width="260" PlaceholderText="Paste an API key (tvly-…)" />
                                <Button Content="Save key" Command="{Binding SaveTavilyKeyCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTavilyKey}">
                                <Button Content="Check key" Command="{Binding CheckTavilyKeyCommand}" IsEnabled="{Binding !IsCheckingTavilyKey}"
                                        ToolTip.Tip="Asks Tavily whether the key works and how much it has used. Costs no credits." />
                                <Button Content="Remove key" Command="{Binding RemoveTavilyKeyCommand}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" HorizontalAlignment="Left">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Monthly credit budget" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding MonthlyCreditBudget}" Minimum="0" Maximum="1000000" Increment="50"
                                               FormatString="0" Width="150" Margin="0,0,0,6"
                                               ToolTip.Tip="Credits contacts may use each period, as counted here. A basic search costs 1 credit." />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Period starts on day" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding CreditResetDay}" Minimum="1" Maximum="28" Increment="1"
                                               FormatString="0" Width="150"
                                               ToolTip.Tip="The day of the month your Tavily credits renew." />
                            </Grid>
                            <TextBlock Text="{Binding WebSearchUsage}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                        </StackPanel>

                        <TextBlock Text="{Binding WebSearchStatus}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>

					<StackPanel Spacing="8">
						<TextBlock Text="About this Application" Classes="section-header" />

						<StackPanel>
							<TextBlock Text="{Binding ApplicationInfo}" />
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="© " />
								<TextBlock Text="{Binding CopyHolder}" />
							</StackPanel>
						</StackPanel>

						<TextBlock TextWrapping="Wrap" Text="{Binding AppDescription}" />

						<StackPanel Orientation="Horizontal" Spacing="12">
							<HyperlinkButton Content="Privacy Statement" NavigateUri="{Binding PrivacyURL}" />
							<HyperlinkButton Content="Issues" NavigateUri="{Binding IssuesURL}" />
						</StackPanel>
					</StackPanel>

				</StackPanel>
			</Grid>
		</ScrollViewer>
	</Border>
</UserControl>
