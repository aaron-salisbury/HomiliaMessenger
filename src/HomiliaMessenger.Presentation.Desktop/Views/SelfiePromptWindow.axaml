<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="480"
        x:Class="HomiliaMessenger.Presentation.Desktop.Views.SelfiePromptWindow"
        xmlns:i="using:Material.Icons.Avalonia"
        xmlns:vm="clr-namespace:HomiliaMessenger.Presentation.Desktop.ViewModels"
        x:DataType="vm:SelfiePromptEditorViewModel"
        Width="600" Height="480" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" CanMinimize="False"
        Title="{Binding Heading}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="24,20,24,20">

        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <i:MaterialIcon Kind="CameraOutline" Width="22" Height="22" Opacity="0.8" />
                <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Prompt" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox Grid.Row="2" x:Name="PromptBox" Text="{Binding Prompt}" TextWrapping="Wrap" AcceptsReturn="False"
                 VerticalContentAlignment="Top" AutomationProperties.Name="Prompt" />
        <TextBlock Grid.Row="3" Text="{Binding PromptLength}" FontSize="11" Opacity="0.6" Margin="0,4,0,0" />

        <StackPanel Grid.Row="4" Spacing="4" Margin="0,12,0,0" IsVisible="{Binding SupportsNegativePrompt}">
            <TextBlock Text="Negative prompt" FontWeight="SemiBold" />
            <TextBox Text="{Binding NegativePrompt}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="56"
                     VerticalContentAlignment="Top" AutomationProperties.Name="Negative prompt" />
            <TextBlock Text="What to steer away from." FontSize="11" Opacity="0.6" />
        </StackPanel>

        <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <Button Grid.Column="0" Command="{Binding ResetCommand}" ToolTip.Tip="Put back the words as planned">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <i:MaterialIcon Kind="Restore" />
                    <TextBlock Text="Reset" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Classes="accent" Command="{Binding TakeCommand}" IsDefault="True">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <i:MaterialIcon Kind="Camera" />
                        <TextBlock Text="Take selfie" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
