<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             x:Class="HomiliaMessenger.Presentation.Desktop.Views.MessengerView"
             xmlns:vm="clr-namespace:HomiliaMessenger.Presentation.Desktop.ViewModels"
             x:DataType="vm:MessengerViewModel"
             xmlns:m="clr-namespace:HomiliaMessenger.Presentation.Desktop.Models"
             xmlns:converters="clr-namespace:HomiliaMessenger.Presentation.Desktop.Base.Converters"
             xmlns:i="using:Material.Icons.Avalonia"
             xmlns:imaging="clr-namespace:Avalonia.Media.Imaging;assembly=Avalonia.Base"
             xmlns:contacts="clr-namespace:HomiliaMessenger.Business.Modules.Contacts;assembly=HomiliaMessenger.Business">

    <!-- Offset default padding so the conversation list aligns with header & nav menu bars. -->
    <UserControl.Margin>-20</UserControl.Margin>

    <UserControl.Resources>
        <converters:BytesToBitmapConverter x:Key="BytesToBitmapConverter" />
        <imaging:Bitmap x:Key="ContactPlaceholder">avares://HomiliaMessenger.Presentation.Desktop/Base/Assets/contact-placeholder.png</imaging:Bitmap>
    </UserControl.Resources>

    <UserControl.Styles>

        <!-- Message bubbles. Grouped bubbles keep rounded outer corners and tighten the corners where they meet. -->
        <Style Selector="Border.bubble">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MaxWidth" Value="520" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="4,18,18,4" />
        </Style>
        <Style Selector="Border.bubble.first">
            <Setter Property="CornerRadius" Value="18,18,18,4" />
        </Style>
        <Style Selector="Border.bubble.last">
            <Setter Property="CornerRadius" Value="4,18,18,18" />
        </Style>
        <Style Selector="Border.bubble.first.last">
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style Selector="Border.bubble.mine">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="CornerRadius" Value="18,4,4,18" />
        </Style>
        <Style Selector="Border.bubble.mine.first">
            <Setter Property="CornerRadius" Value="18,18,4,18" />
        </Style>
        <Style Selector="Border.bubble.mine.last">
            <Setter Property="CornerRadius" Value="18,4,18,18" />
        </Style>
        <Style Selector="Border.bubble.mine.first.last">
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style Selector="Border.bubble.mine SelectableTextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- A bubble and, for a reply that looked something up, its sources button beside it. -->
        <Style Selector="Grid.bubbleRow">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Grid.bubbleRow.mine">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style Selector="StackPanel.message">
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="StackPanel.message.first">
            <Setter Property="Margin" Value="0,8,0,1" />
        </Style>

        <!-- The front photo of a group's pair sits on a ring of the background, so the two photos read as separate. -->
        <Style Selector="Ellipse.groupFront">
            <Setter Property="Stroke" Value="{DynamicResource SystemRegionColor}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>

        <Style Selector="TextBlock.preview.typing">
            <Setter Property="FontStyle" Value="Italic" />
        </Style>

        <!-- Typing indicator: three dots pulsing in turn. -->
        <Style Selector="Ellipse.typingDot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="Opacity" Value="0.3" />
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.typingDot.second">
            <Style.Animations>
                <Animation Duration="0:0:1.2" Delay="0:0:0.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.typingDot.third">
            <Style.Animations>
                <Animation Duration="0:0:1.2" Delay="0:0:0.4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

    </UserControl.Styles>

    <Grid ColumnDefinitions="300,*">

        <!-- Conversation list -->
        <Border Grid.Column="0" CornerRadius="12,0,0,0" ClipToBounds="True" Background="{DynamicResource SystemRegionColor}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10">
                    <TextBox Grid.Column="0" PlaceholderText="Search chats" Text="{Binding SearchText}" AutomationProperties.Name="Search chats">
                        <TextBox.InnerLeftContent>
                            <i:MaterialIcon Kind="Magnify" Width="18" Height="18" Margin="8,0,0,0" Opacity="0.6" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <Button Grid.Column="1" x:Name="NewChatButton" Margin="8,0,0,0" Width="34" Height="34" Padding="0" CornerRadius="17"
                            Background="Transparent" ToolTip.Tip="New chat" AutomationProperties.Name="New chat">
                        <i:MaterialIcon Kind="SquareEditOutline" Width="20" Height="20" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="280" Spacing="8">
                                    <TextBlock Text="New chat" FontWeight="SemiBold" FontSize="15" />
                                    <TextBox PlaceholderText="Search contacts" Text="{Binding ContactSearchText}" AutomationProperties.Name="Search contacts" />
                                    <TextBlock Text="No contacts yet. Add a persona on the Contacts page first." IsVisible="{Binding !HasContacts}"
                                               TextWrapping="Wrap" Opacity="0.7" />
                                    <ListBox ItemsSource="{Binding VisibleContacts}" MaxHeight="320" Background="Transparent"
                                             SelectionChanged="ContactPicker_SelectionChanged" IsVisible="{Binding HasContacts}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="contacts:Contact">
                                                <Grid ColumnDefinitions="36,10,*">
                                                    <Ellipse Grid.Column="0" Width="36" Height="36">
                                                        <Ellipse.Fill>
                                                            <ImageBrush Source="{Binding Photo, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=100, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1" Text="No chats yet. Use the pencil button to start one." IsVisible="{Binding !HasConversations}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="24" Opacity="0.6" />

                <ListBox Grid.Row="1" Background="Transparent" ItemsSource="{Binding VisibleConversations}" SelectedItem="{Binding SelectedConversation}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:ConversationListItem">
                            <Grid ColumnDefinitions="50,10,*,Auto" Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Delete chat" Click="DeleteConversation_Click">
                                            <MenuItem.Icon>
                                                <i:MaterialIcon Kind="TrashCanOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <Ellipse Grid.Column="0" VerticalAlignment="Center" Width="50" Height="50" IsVisible="{Binding !IsGroup}">
                                    <Ellipse.Fill>
                                        <ImageBrush Source="{Binding Contact.Photo, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=100, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <!-- A group's contacts, their photos overlapping. -->
                                <Panel Grid.Column="0" Width="50" Height="50" VerticalAlignment="Center" IsVisible="{Binding IsGroup}">
                                    <Ellipse Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Ellipse.Fill>
                                            <ImageBrush Source="{Binding Contact.Photo, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=100, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Classes="groupFront" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Ellipse.Fill>
                                            <ImageBrush Source="{Binding SecondContact.Photo, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=100, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Panel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <TextBlock Classes="preview" Classes.typing="{Binding IsTyping}" Text="{Binding Preview}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12" Opacity="0.75" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding LastActivity}" FontSize="11" Opacity="0.6" VerticalAlignment="Top" Margin="6,6,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

        <!-- No open chat -->
        <StackPanel Grid.Column="1" IsVisible="{Binding !HasActiveThread}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <i:MaterialIcon Kind="ForumOutline" Width="64" Height="64" Opacity="0.35" />
            <TextBlock Text="Pick a chat, or start a new one with the pencil button. To make a group, invite someone from a chat." Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
        </StackPanel>

        <!-- Thread. Messages and composer stay in a centered, phone-like column (sized in code-behind) so a wide window
             does not pull the two sides of the conversation apart. -->
        <Grid Grid.Column="1" x:Name="ThreadGrid" RowDefinitions="Auto,*,Auto,Auto" IsVisible="{Binding HasActiveThread}">

            <!-- Thread header -->
            <Border Grid.Row="0" Padding="16,10" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="40,12,*,Auto,Auto,Auto,Auto">
                    <Ellipse Grid.Column="0" Width="40" Height="40" IsVisible="{Binding !IsGroupThread}">
                        <Ellipse.Fill>
                            <ImageBrush Source="{Binding ActivePhoto, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=100, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Panel Grid.Column="0" Width="40" Height="40" IsVisible="{Binding IsGroupThread}">
                        <Ellipse Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse.Fill>
                                <ImageBrush Source="{Binding ActivePhoto, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=100, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Classes="groupFront" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Ellipse.Fill>
                                <ImageBrush Source="{Binding ActiveSecondPhoto, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=100, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Panel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveTitle}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ActiveSubtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Stops a reply, or a group's turn-taking, in progress. -->
                    <Button Grid.Column="3" Classes="noBackground" Command="{Binding StopRepliesCommand}" IsVisible="{Binding CanStopReplies}"
                            VerticalAlignment="Center" Opacity="0.7" ToolTip.Tip="Stop replying" AutomationProperties.Name="Stop replying">
                        <i:MaterialIcon Kind="StopCircleOutline" Width="22" Height="22" />
                    </Button>

                    <!-- Invite another contact: starts a new group, leaving this chat as it is. -->
                    <Button Grid.Column="4" x:Name="InviteButton" Classes="noBackground" IsVisible="{Binding CanInvite}"
                            VerticalAlignment="Center" Opacity="0.7" ToolTip.Tip="Invite a contact to a new group" AutomationProperties.Name="Invite contact">
                        <i:MaterialIcon Kind="AccountPlusOutline" Width="22" Height="22" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="280" Spacing="8">
                                    <TextBlock Text="Invite to a new group" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding ActiveContact.DisplayName, StringFormat='Starts a group with you, {0}, and who you choose. This chat stays as it is.'}"
                                               TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="There is no one else to invite yet. Add another persona on the Contacts page." IsVisible="{Binding !InviteCandidates.Count}"
                                               TextWrapping="Wrap" Opacity="0.7" />
                                    <ListBox ItemsSource="{Binding InviteCandidates}" MaxHeight="320" Background="Transparent"
                                             SelectionChanged="InvitePicker_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="contacts:Contact">
                                                <Grid ColumnDefinitions="36,10,*">
                                                    <Ellipse Grid.Column="0" Width="36" Height="36">
                                                        <Ellipse.Fill>
                                                            <ImageBrush Source="{Binding Photo, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=100, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- A group's contacts, what each remembers, and whether they may start conversations. -->
                    <Button Grid.Column="5" Classes="noBackground" IsVisible="{Binding IsGroupThread}"
                            VerticalAlignment="Center" Opacity="0.7" ToolTip.Tip="Group members" AutomationProperties.Name="Group members">
                        <i:MaterialIcon Kind="AccountGroupOutline" Width="22" Height="22" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="8">
                                    <TextBlock Text="In this group" FontWeight="SemiBold" FontSize="15" />
                                    <ItemsControl ItemsSource="{Binding GroupContacts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="contacts:Contact">
                                                <Grid ColumnDefinitions="36,10,*,Auto" Margin="0,4">
                                                    <Ellipse Grid.Column="0" Width="36" Height="36">
                                                        <Ellipse.Fill>
                                                            <ImageBrush Source="{Binding Photo, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=100, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Relationship}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Agent.Model, FallbackValue='Simulated replies', TargetNullValue='Simulated replies'}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Classes="noBackground" VerticalAlignment="Center" Opacity="0.7"
                                                            Command="{Binding $parent[ItemsControl].((vm:MessengerViewModel)DataContext).EditGroupMemoryCommand}" CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding DisplayName, StringFormat='What {0} remembers'}" AutomationProperties.Name="Memory">
                                                        <i:MaterialIcon Kind="NoteTextOutline" Width="20" Height="20" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Each keeps their own personality, model, voice, and memories. What you tell one in private stays theirs."
                                               TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                                    <ToggleSwitch IsChecked="{Binding IsGroupInitiationOn}" OnContent="Occasionally start conversations" OffContent="Wait for me to write first"
                                                  ToolTip.Tip="Whether, now and then, someone in the group starts a conversation when you open it" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Grid.Column="6" Classes="noBackground" Command="{Binding EditMemoryCommand}" IsVisible="{Binding HasConversation}"
                            VerticalAlignment="Center" Opacity="0.7"
                            ToolTip.Tip="{Binding ActiveContact.DisplayName, StringFormat='What {0} remembers'}" AutomationProperties.Name="Memory">
                        <i:MaterialIcon Kind="NoteTextOutline" Width="22" Height="22" />
                    </Button>
                </Grid>
            </Border>

            <!-- Empty new chat -->
            <StackPanel Grid.Row="1" IsVisible="{Binding !HasMessages}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Ellipse Width="96" Height="96" HorizontalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush Source="{Binding ActivePhoto, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=200, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding ActiveTitle}" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyThreadHint}" Opacity="0.6" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Messages -->
            <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MessagesPanel" Margin="16,8,16,12">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:MessageItem">
                                <StackPanel Classes="message" Classes.first="{Binding IsFirstInGroup}">
                                    <TextBlock Text="{Binding TimeSeparator}" IsVisible="{Binding HasTimeSeparator}"
                                               HorizontalAlignment="Center" FontSize="11" Opacity="0.55" Margin="0,10,0,6" />
                                    <!-- In a group, who wrote each run of messages. -->
                                    <TextBlock Text="{Binding SenderName}" IsVisible="{Binding ShowsSenderName}" FontSize="11" Opacity="0.65" Margin="48,0,0,2" />
                                    <Grid ColumnDefinitions="Auto,*">
                                        <!-- Reserves the avatar column for every contact bubble so a group's bubbles line up. -->
                                        <Panel Grid.Column="0" Width="28" Margin="0,0,8,0" VerticalAlignment="Bottom" IsVisible="{Binding !IsFromUser}">
                                            <Ellipse Width="28" Height="28" IsVisible="{Binding ShowsAvatar}">
                                                <Ellipse.Fill>
                                                    <ImageBrush Source="{Binding SenderPhoto, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=100, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Panel>
                                        <!-- A grid rather than a horizontal panel, so a long bubble wraps within the thread's width. -->
                                        <Grid Grid.Column="1" Classes="bubbleRow" Classes.mine="{Binding IsFromUser}" ColumnDefinitions="*,Auto">
                                            <Border Grid.Column="0" Classes="bubble" Classes.mine="{Binding IsFromUser}" Classes.first="{Binding IsFirstInGroup}"
                                                    Classes.last="{Binding IsLastInGroup}" ToolTip.Tip="{Binding SentAtToolTip}">
                                                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            </Border>
                                            <!-- What the contact looked up online for this reply, and where it came from. -->
                                            <Button Grid.Column="1" Margin="4,0,0,0" IsVisible="{Binding HasSources}" VerticalAlignment="Bottom" Padding="4" Opacity="0.6"
                                                    Background="Transparent" BorderThickness="0" ToolTip.Tip="Looked up online · sources">
                                                <i:MaterialIcon Kind="Web" Width="14" Height="14" />
                                                <Button.Flyout>
                                                    <Flyout Placement="RightEdgeAlignedBottom">
                                                        <StackPanel Spacing="4" MaxWidth="360">
                                                            <TextBlock Text="{Binding LookedUp}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <ItemsControl ItemsSource="{Binding Sources}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="m:WebSourceLink">
                                                                        <StackPanel Margin="0,4,0,0">
                                                                            <HyperlinkButton NavigateUri="{Binding Uri}" Padding="0" ToolTip.Tip="{Binding Uri}">
                                                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                                            </HyperlinkButton>
                                                                            <TextBlock Text="{Binding Site}" FontSize="11" Opacity="0.6" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="Search results come from Tavily and may be wrong or out of date." FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Typing indicator -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0" IsVisible="{Binding IsContactTyping}">
                        <Ellipse Grid.Column="0" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Bottom">
                            <Ellipse.Fill>
                                <ImageBrush Source="{Binding TypingContact.Photo, Converter={StaticResource BytesToBitmapConverter}, ConverterParameter=100, TargetNullValue={StaticResource ContactPlaceholder}}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Border Grid.Column="1" Classes="bubble first last" Padding="14,12" ToolTip.Tip="{Binding TypingContact.DisplayName, StringFormat='{}{0} is typing'}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Classes="typingDot" />
                                <Ellipse Classes="typingDot second" />
                                <Ellipse Classes="typingDot third" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Why the contact could not reply -->
            <Border Grid.Row="2" x:Name="ReplyProblemBorder" IsVisible="{Binding HasReplyProblem}" Margin="16,0,16,6" Padding="10,6" CornerRadius="8"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                <Grid ColumnDefinitions="Auto,8,*">
                    <i:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{StaticResource OrangeAccent}" VerticalAlignment="Top" />
                    <SelectableTextBlock Grid.Column="2" Text="{Binding ReplyProblem}" TextWrapping="Wrap" FontSize="12" />
                </Grid>
            </Border>

            <!-- Composer -->
            <Border Grid.Row="3" Padding="16,10" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
                <Grid x:Name="ComposerGrid" ColumnDefinitions="*,10,Auto">
                    <TextBox Grid.Column="0" x:Name="Composer" Text="{Binding DraftText}" AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="140" MinHeight="38" CornerRadius="19" Padding="14,9" VerticalContentAlignment="Center" MaxLength="4000"
                             PlaceholderText="{Binding ComposerPlaceholder}" AutomationProperties.Name="Message" />
                    <Button Grid.Column="2" Classes="accent" Command="{Binding SendCommand}" Width="38" Height="38" Padding="0" CornerRadius="19"
                            VerticalAlignment="Bottom" ToolTip.Tip="Send (Enter). Shift+Enter for a new line." AutomationProperties.Name="Send">
                        <i:MaterialIcon Kind="Send" Width="18" Height="18" />
                    </Button>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
