<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="60"
             x:Class="HomiliaMessenger.Presentation.Desktop.Base.Controls.RibbonControls.MessengerRibbonControl"
             xmlns:vm="clr-namespace:HomiliaMessenger.Presentation.Desktop.ViewModels"
             x:DataType="vm:MessengerViewModel"
             xmlns:i="using:Material.Icons.Avalonia"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="i|MaterialIcon">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

        <TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding Status}" VerticalAlignment="Center" Margin="0,0,12,0"
                   MaxWidth="420" TextTrimming="CharacterEllipsis" Opacity="0.8" />

        <StackPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">

            <Button Command="{Binding RefreshCommand}" ToolTip.Tip="Reload chats">
                <i:MaterialIcon Kind="Refresh" />
            </Button>

            <Button Command="{Binding DeleteConversationCommand}" ToolTip.Tip="Delete chat">
                <i:MaterialIcon Kind="TrashCanOutline" />
            </Button>

        </StackPanel>

    </StackPanel>
</UserControl>
