<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
	<ApplicationIcon>..\HomiliaMessenger.Presentation.Desktop\Base\Assets\icon.ico</ApplicationIcon>
	<AssemblyName>HomiliaMessenger</AssemblyName>
	<AssemblyTitle>Homilia Messenger</AssemblyTitle>
	<Product>Homilia Messenger</Product>
	<Description>A messenger where every contact is an AI persona. Experiment with conversations with agents.</Description>
	<Authors>Aaron Salisbury</Authors>
	<Copyright>© Aaron Salisbury</Copyright>
	<Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
	<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
	<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\HomiliaMessenger.Business\HomiliaMessenger.Business.csproj" />
	<ProjectReference Include="..\HomiliaMessenger.Data\HomiliaMessenger.Data.csproj" />
	<ProjectReference Include="..\HomiliaMessenger.Integrations\HomiliaMessenger.Integrations.csproj" />
	<ProjectReference Include="..\HomiliaMessenger.Presentation.Desktop\HomiliaMessenger.Presentation.Desktop.csproj" />
  </ItemGroup>
</Project>
